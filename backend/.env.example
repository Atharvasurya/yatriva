# =============================================================================
# Yatriva Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# ─── PostgreSQL / Neon ───────────────────────────────────────────────────────
# Neon connection strings always include ?sslmode=require
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://yatriva_owner:CHANGE_ME@ep-XXXX.us-east-2.aws.neon.tech/yatriva?sslmode=require

# ─── CORS — Frontend URL ─────────────────────────────────────────────────────
# The exact origin Vercel assigns to your frontend (no trailing slash).
# Add both the production URL and any preview URL you want to allow.
# Local dev is always allowed regardless of this value.
FRONTEND_URL=https://yatriva.vercel.app

# ─── Auth — JWT ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_64_char_hex_secret

# ─── OTP SMS Provider ────────────────────────────────────────────────────────
# Leave blank (or "demo_mode") for local development — OTP will be "1234".
# Set to your SMS provider name (e.g. "twilio", "msg91") for production.
OTP_SMS_PROVIDER=demo_mode

# ─── Qdrant (Phase 4 — skip for now) ────────────────────────────────────────
# Only needed when migrating from in-memory Qdrant to Qdrant Cloud.
# QDRANT_URL=https://YOUR_CLUSTER_ID.us-east4-0.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=CHANGE_ME
